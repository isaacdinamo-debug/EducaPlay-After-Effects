# Rutas de ESTA computadora. Copiá este archivo a motor/.env y completalo.
# motor/.env no se versiona: cada PC tiene el suyo.
# Las rutas pueden tener espacios (no hace falta comillas), pero ninguna carpeta
# puede terminar en espacio: Windows no la admite.

# Carpeta de entregas: una subcarpeta por capítulo, <CODE>/, con el máster,
# la escaleta .docx y RECURSOS/. La usa `npm run nuevo`.
#   macOS:   EDUCAPLAY_EPISODES=/Users/<usuario>/Documents/Educaplay/Entregas
#   Windows: EDUCAPLAY_EPISODES=C:\Educaplay\Entregas
EDUCAPLAY_EPISODES=

# Carpeta con public/ (public/videos/<CODE>.mp4, public/<CODE>/, public/fonts/)
# de donde `npm run medios` trae los medios de un capítulo ya medido.
EDUCAPLAY_MEDIOS=

# Opcional: After Effects a usar (si no, el más nuevo instalado).
#   macOS:   AE_APP=Adobe After Effects 2026
#   Windows: AE_APP=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\AfterFX.exe
# AE_APP=
